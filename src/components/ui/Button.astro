---
interface Props {
  variant?: "accent" | "ghost" | "outline";
  href?: string;
  type?: "button" | "submit";
  class?: string;
}
const { variant = "accent", href, type = "button", class: className = "" } = Astro.props;
const Tag = href ? "a" : "button";
const attrs = href ? { href } : { type };
---
<Tag class:list={["btn", `btn-${variant}`, className]} {...attrs}>
  <slot />
</Tag>
<style>
  .btn {
    display: inline-flex; align-items: center; gap: .5em; font-weight: 600;
    font-size: .96rem; padding: .8em 1.35em; border-radius: 999px;
    border: 1px solid transparent; cursor: pointer; font-family: var(--font-sans);
    text-decoration: none; transition: transform .15s, box-shadow .2s, background .2s, color .2s;
  }
  .btn-accent { background: var(--color-accent); color: var(--color-on-accent); }
  .btn-accent:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -10px color-mix(in oklab, var(--color-accent) 60%, transparent);
  }
  .btn-ghost { background: transparent; color: var(--color-on-dark); border-color: var(--color-line-dark); }
  .btn-ghost:hover { border-color: var(--color-accent-2); color: var(--color-accent-2); }
  .btn-outline { background: transparent; color: var(--color-ink-2); border-color: var(--color-line); }
  .btn-outline:hover { border-color: var(--color-ink); }
</style>
