---
interface Props {
  variant?: "full" | "mark";
  label?: string;
  tone?: "dark" | "light";
  size?: number;
}
const { variant = "full", label = "CF App", tone = "dark", size = 28 } = Astro.props;
const wordColor = tone === "dark" ? "var(--color-on-dark)" : "var(--color-ink)";
---
<span class="brand" style={`--word:${wordColor}`}>
  <svg class="mark" width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect x="2" y="2" width="28" height="28" rx="8" fill="var(--color-ink)" />
    <circle cx="16" cy="16" r="5" fill="var(--color-accent)" />
    <circle cx="16" cy="16" r="9" stroke="var(--color-accent-2)" stroke-width="1.5" opacity=".6" />
  </svg>
  {variant === "full" && <span class="word">{label}</span>}
</span>
<style>
  .brand { display: inline-flex; align-items: center; gap: .55em; }
  .mark { flex: 0 0 auto; }
  .word { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; letter-spacing: -.02em; color: var(--word); }
</style>
