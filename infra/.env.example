# Copy to infra/.env (gitignored). pulumi.sh sources this file.
#
# A Cloudflare API token with, on this account: D1 Edit, Workers R2 Storage Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Pulumi encrypts stack secrets with this passphrase (no Pulumi Cloud account needed).
PULUMI_CONFIG_PASSPHRASE=

# State backend: an R2 bucket you create by hand ONCE (it cannot manage itself).
# The S3-compatible endpoint is https://<account-id>.r2.cloudflarestorage.com.
PULUMI_BACKEND_URL="s3://cf-app-pulumi-state?endpoint=<account-id>.r2.cloudflarestorage.com&region=auto&s3ForcePathStyle=true"
# An R2 API token (Object Read & Write on that bucket), exposed as S3 credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Prefer a secrets manager? Delete the values above and run e.g.
#   op run --env-file=infra/.env -- ./infra/pulumi.sh preview
# with `op://vault/item/field` references in place of the literals.
